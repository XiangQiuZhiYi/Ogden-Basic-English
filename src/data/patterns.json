    ],
    "commonMistakes": [
      "seem 后可直接接 quality，不需要额外使用 be。"
    ],
    "grammarRefs": [
      "qualities-position"
    ],
    "sourceRefs": [
      "ogden-course"
    ],
    "reviewStatus": "结构已核验"
