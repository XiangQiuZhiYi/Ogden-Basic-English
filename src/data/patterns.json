[
  {
    "id": "be-thing",
    "family": "state",
    "familyZh": "身份与状态",
    "operators": [
      "be"
    ],
    "formula": "THING + be + THING",
    "functionZh": "说明身份、名称或归类",
    "explanationZh": "be 把主语与说明其身份或类别的 thing 连接起来。",
    "examples": [
      {
        "en": "This is a book.",
        "zh": "这是一本书。"
      },
      {
        "en": "A house is a building.",
        "zh": "房屋是一种建筑。"
      }
    ],
    "variations": [
      "THIS/THAT + be + THING",
      "THING + be + A/AN + THING"
    ],
    "commonMistakes": [
      "单数可数 thing 通常不能遗漏 a/an 或其他限定词。"
    ],
    "grammarRefs": [
      "basic-order",
      "nouns-articles"
    ],
    "sourceRefs": [
      "ogden-step-1"
    ],
    "reviewStatus": "结构已核验"
  },
  {
    "id": "be-quality",
    "family": "state",
    "familyZh": "身份与状态",
    "operators": [
      "be"
    ],
    "formula": "THING + be + QUALITY",
    "functionZh": "说明性质或状态",
    "explanationZh": "quality 放在 be 后说明主语当前或一般具有的性质。",
    "examples": [
      {
        "en": "The room is cold.",
        "zh": "房间很冷。"
      },
      {
        "en": "The answer is clear.",
        "zh": "答案很清楚。"
      }
    ],
    "variations": [
      "THING + be + not + QUALITY"
    ],
    "commonMistakes": [
      "quality 在 be 后不随主语变形。"
    ],
    "grammarRefs": [
      "qualities-position"
    ],
    "sourceRefs": [
      "ogden-step-1"
    ],
    "reviewStatus": "结构已核验"
  },
  {
    "id": "be-direction",
