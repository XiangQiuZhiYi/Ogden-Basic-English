    "commonMistakes": [
      "否定和疑问中的实义 have 通常借助 do。"
    ],
    "grammarRefs": [
      "questions-negatives",
      "nouns-articles"
    ],
    "sourceRefs": [
      "ogden-course"
    ],
    "reviewStatus": "结构已核验"
  },
