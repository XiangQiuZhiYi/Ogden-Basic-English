    "variations": [
      "THING + be + HERE/THERE",
      "THING + be + DIRECTION + THING"
    ],
    "commonMistakes": [
      "先判断是在说明静态位置，还是在说明移动方向。"
    ],
    "grammarRefs": [
      "directions"
    ],
    "sourceRefs": [
      "ogden-step-1"
    ],
    "reviewStatus": "结构已核验"
